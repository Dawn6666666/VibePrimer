{
  "name": "vibe-coding-primer",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "写给大一下的 Vibe Coding 交互入门指南",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev": "vuepress dev docs --port 4500",
    "build": "vuepress build docs --clean-cache --clean-temp",
    "clean": "rm -rf docs/.vuepress/.temp docs/.vuepress/.cache docs/.vuepress/dist",
    "preview": "vuepress build docs --clean-cache --clean-temp && npx serve docs/.vuepress/dist"
  },
  "devDependencies": {
    "@iconify/json": "^2.2.0",
    "@vuepress/bundler-vite": "2.0.0-rc.31",
    "mermaid": "^11.12.0",
    "typescript": "^5.9.0",
    "vue": "^3.5.0",
    "vuepress": "2.0.0-rc.31",
    "vuepress-plugin-md-power": "1.0.0-rc.214",
    "vuepress-theme-plume": "1.0.0-rc.214"
  }
}
